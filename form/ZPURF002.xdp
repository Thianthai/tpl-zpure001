               <draw name="Remark" x="0.53mm" usehref=".#som($template.#subform.designer__stylesheet.TextStyle9)" y="0.174mm" h="32.592mm" w="107.42mm">
                  <ui>
                     <textEdit/>
                  </ui>
                  <value>
                     <exData contentType="text/html" xliff:rid="859C31CC-CBC1-4699-AA1C-C1864064DB43">
                        <body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/"><p style="margin-bottom:2pt;xfa-font-horizontal-scale:98%;text-decoration:none;letter-spacing:0in">โปรดระบุเลขที่ใบสั่งซื้อลงในใบส่งของ/งาน บิล หรืออินวอยส์เพื่อสะดวกในการจ่ายเงิน</p><p style="margin-bottom:2pt;xfa-font-horizontal-scale:98%;text-decoration:none;letter-spacing:0in">To faclilitate payment, please indicate the P.O. No. In all Delivery Orders or Invoices</p><p style="margin-bottom:2pt;xfa-font-horizontal-scale:98%;text-decoration:none;letter-spacing:0in">การตกลงรับใบสั่งซื้อนี้เป็นการยอมรับข้อกำหนดซื้อที่ระบุในใบสั่งซื้อทั้งด้านหน้าและด้านหลังของ</p><p style="margin-bottom:2pt;xfa-font-horizontal-scale:98%;text-decoration:none;letter-spacing:0in">เอกสารนี้</p><p style="margin-bottom:2pt;xfa-font-horizontal-scale:98%;text-decoration:none;letter-spacing:0in">Acceptance of the order means acceptance of all the above conditions and those stated<span style="xfa-spacerun:yes"> </span></p><p style="margin-bottom:2pt;xfa-font-horizontal-scale:98%;text-decoration:none;letter-spacing:0in">on the reverse side of this form<span style="xfa-tab-count:1">         </span><span style="xfa-font-horizontal-scale:100%"><br/></span><br/></p></body>
                     </exData>
                  </value>
                  <border>
                     <edge presence="hidden" stroke="solid" thickness="0.5pt">
                        <color value="0,0,0"/>
                     </edge>
                     <edge presence="visible" stroke="solid" thickness="0.5pt">
                        <color value="0,0,0"/>
                     </edge>
                     <edge presence="hidden" stroke="solid" thickness="0.5pt">
